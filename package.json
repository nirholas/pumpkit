{
  "name": "pumpkit",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source framework for building PumpFun Telegram bots on Solana",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "nirholas",
    "url": "https://github.com/nirholas"
  },
  "contributors": [
    {
      "name": "nichxbt",
      "url": "https://x.com/nichxbt"
    }
  ],
  "homepage": "https://github.com/nirholas/pumpkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/pumpkit.git"
  },
  "bugs": {
    "url": "https://github.com/nirholas/pumpkit/issues"
  },
  "workspaces": [
    "packages/*",
    "examples/claim-alert"
  ],
  "scripts": {
    "postinstall": "node tools/patch-pump-sdk.mjs",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "bigint-buffer": "file:vendor/bigint-buffer"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "toml@<=5.0.0": "^5.0.1",
    "toml@<4.2.0": "^5.0.1",
    "toml@<4.1.2": "^5.0.1",
    "stream-json@<=3.5.0": "^3.6.0",
    "stream-json@<3.6.0": "^3.6.0",
    "stream-json@<=3.4.0": "^3.6.0",
    "uuid@<11.1.1": "^11.1.1",
    "bigint-buffer": "$bigint-buffer"
  }
}
