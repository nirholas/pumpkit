{
  "name": "@pumpkit/core",
  "version": "1.0.0",
  "description": "Shared utilities for PumpKit bots — logger, health server, config helpers, and common types",
  "license": "Apache-2.0",
  "author": "nirholas <https://github.com/nirholas> (https://x.com/nichxbt)",
  "homepage": "https://github.com/nirholas/pumpkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/pumpkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nirholas/pumpkit/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js"
    },
    "./shutdown": {
      "types": "./dist/shutdown.d.ts",
      "import": "./dist/shutdown.js"
    },
    "./formatter": {
      "types": "./dist/formatter/index.d.ts",
      "import": "./dist/formatter/index.js"
    },
    "./http": {
      "types": "./dist/net/http.d.ts",
      "import": "./dist/net/http.js"
    },
    "./file-store": {
      "types": "./dist/storage/FileStore.d.ts",
      "import": "./dist/storage/FileStore.js"
    },
    "./events": {
      "types": "./dist/solana/events.d.ts",
      "import": "./dist/solana/events.js"
    },
    "./programs": {
      "types": "./dist/solana/programs.d.ts",
      "import": "./dist/solana/programs.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "import": "./dist/util/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/vitest-env.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../tools/lint-check.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bn.js": "^5.2.2",
    "dotenv": "^18.0.9"
  },
  "peerDependencies": {
    "@nirholas/pump-sdk": "^3.0.0",
    "@pump-fun/pump-sdk": "^4.0.0",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.1.1",
    "grammy": "^1.46.0"
  },
  "peerDependenciesMeta": {
    "@nirholas/pump-sdk": {
      "optional": true
    },
    "@pump-fun/pump-sdk": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "grammy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nirholas/pump-sdk": "^3.0.0",
    "@pump-fun/pump-sdk": "^4.0.0",
    "@solana/web3.js": "^1.99.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
