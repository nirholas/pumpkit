{
  "name": "@pumpkit/tracker",
  "version": "1.0.0",
  "description": "Telegram call-tracking bot with leaderboards, PNL cards, and performance analytics",
  "license": "Apache-2.0",
  "author": "nirholas <https://github.com/nirholas> (https://x.com/nichxbt)",
  "homepage": "https://github.com/nirholas/pumpkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/pumpkit.git",
    "directory": "packages/tracker"
  },
  "bugs": {
    "url": "https://github.com/nirholas/pumpkit/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pumpkit-tracker": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../tools/lint-check.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "@pumpkit/core": "^1.0.0",
    "better-sqlite3": "^13.1.1",
    "canvas": "^3.1.0",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
